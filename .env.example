# ==========================================
# Vaulto Environment Configuration
# ==========================================

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth JWT Secret (Any random 32+ char secret string)
JWT_SECRET=vaulto_production_jwt_super_secret_key_change_me_2026

# Telegram Bot Integration (Optional for local testing - interactive sandbox works immediately!)
# Obtain via Telegram @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Stripe Payments & Paid Tier Subscriptions (Optional for testing - sandbox test mode works out of the box!)
# Obtain via Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Database Configuration (Defaults to persistent embedded store at data/db.json)
# DATABASE_URL=postgresql://user:password@localhost:5432/vaulto
